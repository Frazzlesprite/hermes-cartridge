{
  "name": "hermes-cartridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A handheld ROM emulator pane that runs while Hermes works and pauses when it needs you.",
  "license": "MIT",
  "homepage": "https://github.com/Frazzlesprite/hermes-cartridge",
  "scripts": {
    "build": "node tools/build.mjs",
